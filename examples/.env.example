# Золотой набор рамы. Кузов копирует файл и добавляет свои переменные.
# Секреты и живые ID сюда не класть.

BOT_TOKEN=
SUPPORT_CHAT_ID=
AUDIT_CHAT_ID=

# Темы супергруппы. Пусто — общий чат, message_thread_id не передаётся.
SUPPORT_THREAD_ID=
AUDIT_THREAD_ID=
OPS_THREAD_ID=
EVENTS_THREAD_ID=

CHASSIS_BOT_ID=demo
CHASSIS_ORIGIN_BOT_ID=
CHASSIS_DB_PATH=bot_chassis.db
CHASSIS_SUPERADMIN_IDS=
ADMIN_IDS=

CHASSIS_ENABLE_LANGUAGE_SWITCH=0
CHASSIS_ENABLE_REFERRALS=0

# BackupPolicy и ReportingPolicy — аргументы фабрики, не переменные окружения.
# Канал отзывов, брокеры и домен кузов добавляет в своём .env.example.
